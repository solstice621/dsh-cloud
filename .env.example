# Production control service. Copy to .env and chmod 600 .env.
CLOUD_PUBLIC_URL=https://cloud.example.com
CLOUD_DOMAIN=cloud.example.com
CLOUD_HOST=127.0.0.1
CLOUD_PORT=8787
CLOUD_DATABASE=.state/control.sqlite
CLOUD_TEMPLATES=deploy/templates.json
CLOUD_GIT_HOSTS=github.com
CLOUD_OIDC_ISSUER=https://identity.example.com
CLOUD_OIDC_CLIENT_ID=dsh-cloud
CLOUD_OIDC_CLIENT_SECRET=
CLOUD_OWNER_SUBJECT=replace-with-your-stable-oidc-sub
CLOUD_MODEL_BASE_URL=https://api.deepseek.com/anthropic
CLOUD_MODEL_NAME=deepseek-flash
CLOUD_MODEL_API_KEY=
NODE_USE_ENV_PROXY=1
NO_PROXY=localhost,127.0.0.1,host.docker.internal
# Optional reachable company egress; never change the machine's system proxy.
# HTTP_PROXY=http://proxy.sha.sap.corp:8080
# HTTPS_PROXY=http://proxy.sha.sap.corp:8080
# Development only: use a loopback public URL, then explicitly enable both:
# CLOUD_DEVELOPMENT=1
# CLOUD_DEV_TOKEN=replace-with-a-random-string-of-at-least-32-characters
