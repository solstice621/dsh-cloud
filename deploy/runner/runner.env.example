# chmod 600 runner.env. Only the supervisor reads this file.
# Fine-grained GitHub token: repository Contents write + Pull requests write.
CLOUD_GITHUB_TOKEN=
NODE_USE_ENV_PROXY=1
NO_PROXY=localhost,127.0.0.1,host.docker.internal
# HTTP_PROXY=http://proxy.sha.sap.corp:8080
# HTTPS_PROXY=http://proxy.sha.sap.corp:8080
# NODE_EXTRA_CA_CERTS=/absolute/path/to/company-ca.pem
# GIT_SSL_CAINFO=/absolute/path/to/company-ca.pem
