{
  "name": "dsh-cloud-plugin",
  "version": "0.1.3",
  "description": "Persistent remote DSH tasks across devices and self-hosted runners",
  "type": "module",
  "main": "host.js",
  "engines": {
    "dsh": "0.2.1-rc.5 || 0.2.2-alpha.2",
    "node": ">=24.19.0 <25"
  },
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "zod": "4.4.3",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5 || 4.0.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5 || 0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.5 || 0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5 || 0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5 || 0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5 || 0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.5 || 0.2.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5 || 0.2.2-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    }
  }
}
